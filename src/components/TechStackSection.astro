---
import skillsData from '../data/skills.json';

const getIconForSkill = (skill: string) => {
  const t = skill.toLowerCase();
  if (t.includes('kubernetes')) return 'devicon-kubernetes-plain';
  if (t.includes('aws') || t.includes('amazon')) return 'devicon-amazonwebservices-plain-wordmark';
  if (t.includes('gcp')) return 'devicon-googlecloud-plain';
  if (t.includes('terraform')) return 'devicon-terraform-plain';
  if (t.includes('go')) return 'devicon-go-plain';
  if (t.includes('docker')) return 'devicon-docker-plain';
  if (t.includes('rust')) return 'devicon-rust-plain';
  if (t.includes('node')) return 'devicon-nodejs-plain';
  if (t.includes('react')) return 'devicon-react-original';
  if (t.includes('css')) return 'devicon-css3-plain';
  if (t.includes('html')) return 'devicon-html5-plain';
  if (t.includes('typescript') || t.includes('ts')) return 'devicon-typescript-plain';
  if (t.includes('javascript') || t.includes('js')) return 'devicon-javascript-plain';
  if (t.includes('python')) return 'devicon-python-plain';
  if (t.includes('postgresql') || t.includes('sql')) return 'devicon-postgresql-plain';
  if (t.includes('redis')) return 'devicon-redis-plain';
  if (t.includes('kafka')) return 'devicon-apachekafka-original';
  if (t.includes('graphql')) return 'devicon-graphql-plain';
  return 'material-symbols-outlined';
};

const allSkills = skillsData.skillCategories.flatMap(c => c.skills);
// Duplicate the array a few times to ensure enough content for smooth scrolling
const displaySkills = [...allSkills, ...allSkills, ...allSkills];
---

<section class="w-full py-section-gap overflow-hidden bg-surface text-on-background border-y border-outline-variant/30 scroll-mt-32 relative" id="tech-stack">
  
  <div class="px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto mb-16 tech-header relative z-10">
    <h2 class="font-headline-md text-3xl md:text-5xl text-primary font-bold">
      Technical Arsenal
    </h2>
  </div>

  {/* GSAP Marquee Container */}
  <div class="relative w-full flex flex-col gap-8 py-10 md:py-16 transform -rotate-2 scale-105 bg-[#0a0a0a] border-y border-outline-variant/20 shadow-2xl">
    
    <div class="absolute inset-0 bg-gradient-to-r from-[#0a0a0a] via-transparent to-[#0a0a0a] z-10 pointer-events-none w-full"></div>

    <div class="tech-marquee-wrapper overflow-hidden flex w-[200%]">
      <div class="tech-marquee-content flex gap-12 md:gap-24 items-center whitespace-nowrap px-6">
        {displaySkills.map((skill) => {
          const iconClass = getIconForSkill(skill.name);
          const isMaterial = iconClass === 'material-symbols-outlined';
          return (
            <div class="flex items-center gap-6 group cursor-default opacity-60 hover:opacity-100 transition-opacity duration-300">
              {isMaterial ? (
                <span class={`${iconClass} text-5xl md:text-7xl text-primary`} aria-hidden="true">code</span>
              ) : (
                <i class={`${iconClass} text-5xl md:text-7xl text-primary`} aria-hidden="true"></i>
              )}
              <span class="font-headline-md text-3xl md:text-5xl text-secondary group-hover:text-primary transition-colors tracking-tighter">
                {skill.name.split(' / ')[0]}
              </span>
            </div>
          )
        })}
      </div>
    </div>

  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Section Header Reveal
  gsap.fromTo('.tech-header', 
    { y: 30, opacity: 0 },
    {
      y: 0,
      opacity: 1,
      duration: 1,
      ease: 'power3.out',
      scrollTrigger: {
        trigger: '#tech-stack',
        start: 'top 80%',
      }
    }
  );

  // GSAP Marquee with Scroll Velocity
  const marqueeWrapper = document.querySelector('.tech-marquee-wrapper');
  const marqueeContent = document.querySelector('.tech-marquee-content');

  if (marqueeWrapper && marqueeContent) {
    // Clone content for seamless loop
    const clone = marqueeContent.cloneNode(true);
    marqueeWrapper.appendChild(clone);

    // Initial tween setup
    let xPos = 0;
    let speed = 0.05; // Base speed
    
    const ticker = gsap.ticker.add(() => {
      xPos -= speed;
      // Reset position when first block fully exits screen
      // 50% because we cloned it (wrapper is 200% width, each child is 100%)
      if (xPos <= -50) {
        xPos = 0;
      }
      gsap.set(marqueeWrapper, { xPercent: xPos });
    });

    // Speed up on scroll
    ScrollTrigger.create({
      trigger: 'body',
      start: 'top top',
      end: 'bottom bottom',
      onUpdate: (self) => {
        // self.getVelocity() returns pixels per second
        // map velocity to speed
        const velocity = Math.abs(self.getVelocity());
        const targetSpeed = 0.05 + (velocity / 3000); // add extra speed
        
        // animate the speed variable itself for smooth ramp up/down
        gsap.to({ val: speed }, {
          val: targetSpeed,
          duration: 0.1,
          onUpdate: function() {
            speed = this.targets()[0].val;
          },
          onComplete: () => {
            // Decay back to base speed
            gsap.to({ val: speed }, {
              val: 0.05,
              duration: 1,
              ease: 'power2.out',
              onUpdate: function() {
                speed = this.targets()[0].val;
              }
            });
          }
        });
      }
    });
  }
</script>
