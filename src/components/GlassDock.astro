---
import { GlassDock } from './ui/glass-dock';
---

<div class="glass-dock-wrapper hidden md:flex fixed bottom-8 left-1/2 -translate-x-1/2 z-[100] will-change-transform pb-4 px-4">
  <GlassDock client:load />
</div>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const dockWrapper = document.querySelector('.glass-dock-wrapper');

  if (dockWrapper) {
    // Initial entrance animation
    gsap.from(dockWrapper, {
      y: 100,
      opacity: 0,
      duration: 1.2,
      ease: 'elastic.out(1, 0.5)',
      delay: 0.8
    });

    // Scroll-driven collapse behavior
    let isCollapsed = false;

    ScrollTrigger.create({
      start: 'top top',
      end: 'max',
      onUpdate: (self) => {
        const isNearTop = self.progress < 0.05;
        const isNearBottom = self.progress > 0.98;

        // If scrolling down with decent velocity
        if (self.direction === 1 && !isNearTop && !isNearBottom && Math.abs(self.getVelocity()) > 50) {
          if (!isCollapsed) {
            isCollapsed = true;
            gsap.to(dockWrapper, {
              y: 80, 
              scale: 0.8,
              opacity: 0.2,
              duration: 0.4,
              ease: 'power3.inOut'
            });
          }
        } else if ((self.direction === -1 && Math.abs(self.getVelocity()) > 20) || isNearTop || isNearBottom) {
          if (isCollapsed) {
            isCollapsed = false;
            gsap.to(dockWrapper, {
              y: 0,
              scale: 1,
              opacity: 1,
              duration: 0.6,
              ease: 'back.out(1.2)'
            });
          }
        }
      }
    });

    // Mouse proximity listener to expand if hidden
    window.addEventListener('mousemove', (e) => {
      if (isCollapsed && window.innerHeight - e.clientY < 100) {
        isCollapsed = false;
        gsap.to(dockWrapper, {
          y: 0,
          scale: 1,
          opacity: 1,
          duration: 0.6,
          ease: 'back.out(1.2)'
        });
      }
    });
  }
</script>
