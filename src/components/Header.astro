---
import profileData from '../data/profile.json';
---

<header class="bg-surface/70 backdrop-blur-xl w-full sticky top-0 z-50 border-b border-outline-variant/30 shadow-[0_4px_30px_rgba(0,0,0,0.1)] transition-all duration-300">
  <div class="flex justify-between items-center w-full px-margin-mobile md:px-margin-desktop py-4 max-w-container-max mx-auto">
    <a
      class="logo-animate font-logo text-xl font-bold tracking-[0.2em] text-primary uppercase focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded-sm hover:opacity-80 transition-opacity"
      href="#"
    >
      {profileData.name}_21x
    </a>
    <nav class="hidden md:flex space-x-8 lg:space-x-12 items-center">
      <a
        class="font-label-sm text-label-sm uppercase tracking-widest text-secondary hover:text-primary transition-colors relative after:absolute after:left-0 after:-bottom-1.5 after:h-[1px] after:w-full after:bg-primary after:scale-x-0 after:origin-center hover:after:scale-x-100 after:transition-transform after:duration-500 after:ease-[cubic-bezier(0.22,1,0.36,1)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-on-primary rounded-sm"
        href="#experience"
      >Experience</a>
      <a
        class="font-label-sm text-label-sm uppercase tracking-widest text-secondary hover:text-primary transition-colors relative after:absolute after:left-0 after:-bottom-1.5 after:h-[1px] after:w-full after:bg-primary after:scale-x-0 after:origin-center hover:after:scale-x-100 after:transition-transform after:duration-500 after:ease-[cubic-bezier(0.22,1,0.36,1)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-on-primary rounded-sm"
        href="#projects"
      >Projects</a>
      <a
        class="font-label-sm text-label-sm uppercase tracking-widest text-secondary hover:text-primary transition-colors relative after:absolute after:left-0 after:-bottom-1.5 after:h-[1px] after:w-full after:bg-primary after:scale-x-0 after:origin-center hover:after:scale-x-100 after:transition-transform after:duration-500 after:ease-[cubic-bezier(0.22,1,0.36,1)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-on-primary rounded-sm"
        href="#certificates"
      >Certificates</a>
      
      <button
        id="theme-toggle"
        class="btn-luxury-icon"
        aria-label="Toggle theme"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transform transition-transform duration-500 hover:rotate-45"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
      </button>

      <a
        class="hidden md:inline-flex items-center gap-2 px-6 py-2.5 rounded-full bg-white text-black font-label-sm text-xs font-medium uppercase tracking-[0.15em] hover:bg-white/90 shadow-[inset_0_1px_0_rgba(255,255,255,1),0_4px_20px_-2px_rgba(255,255,255,0.25)] hover:shadow-[inset_0_1px_0_rgba(255,255,255,1),0_0_25px_rgba(255,255,255,0.35)] hover:-translate-y-0.5 active:scale-95 transition-all duration-300 group"
        href="#contact"
      >
        <span>Connect</span>
        <span class="material-symbols-outlined text-sm transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform duration-300" aria-hidden="true">arrow_outward</span>
      </a>
    </nav>
    <div class="md:hidden flex items-center space-x-3">
      <button
        id="theme-toggle-mobile"
        class="btn-luxury-icon !w-9 !h-9"
        aria-label="Toggle theme"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
      </button>
      <button
        id="mobile-menu-btn"
        class="btn-luxury-icon !w-9 !h-9 text-primary"
        aria-label="Toggle Menu"
        aria-expanded="false"
      >
        <span class="material-symbols-outlined text-xl" aria-hidden="true">menu</span>
      </button>
    </div>
  </div>

  <!-- Mobile Menu Dropdown -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-outline-variant/30 bg-surface/95 backdrop-blur-2xl px-margin-mobile py-6 space-y-4">
    <a class="mobile-link block font-label-sm text-sm uppercase tracking-widest text-secondary hover:text-primary py-2 transition-colors" href="#experience">Experience</a>
    <a class="mobile-link block font-label-sm text-sm uppercase tracking-widest text-secondary hover:text-primary py-2 transition-colors" href="#projects">Projects</a>
    <a class="mobile-link block font-label-sm text-sm uppercase tracking-widest text-secondary hover:text-primary py-2 transition-colors" href="#certificates">Certificates</a>
    <a class="mobile-link inline-flex items-center gap-2 px-6 py-2.5 rounded-full bg-white text-black font-label-sm text-xs font-medium uppercase tracking-[0.15em] mt-2" href="#contact">
      <span>Connect</span>
      <span class="material-symbols-outlined text-sm" aria-hidden="true">arrow_outward</span>
    </a>
  </div>
</header>
