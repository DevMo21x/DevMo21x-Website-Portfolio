---
import profileData from '../data/profile.json';
---

<header class="bg-surface-container-low/90 backdrop-blur-md w-full sticky top-0 z-50 border-b border-outline-variant/30">
  <div class="flex justify-between items-center w-full px-margin-mobile md:px-margin-desktop py-4 max-w-container-max mx-auto">
    <a
      class="logo-animate font-logo text-xl font-bold tracking-[0.2em] text-primary uppercase focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded-sm"
      href="#"
    >
      {profileData.name}_21x
    </a>
    <nav class="hidden md:flex space-x-8 lg:space-x-12 items-center">
      <a
        class="font-label-sm text-label-sm uppercase tracking-widest text-secondary hover:text-primary transition-colors relative after:absolute after:left-0 after:-bottom-1 after:h-[1px] after:w-full after:bg-primary after:scale-x-0 after:origin-right hover:after:scale-x-100 hover:after:origin-left after:transition-transform after:duration-300 after:ease-out focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-on-primary rounded-sm"
        href="#experience"
      >Experience</a>
      <a
        class="font-label-sm text-label-sm uppercase tracking-widest text-secondary hover:text-primary transition-colors relative after:absolute after:left-0 after:-bottom-1 after:h-[1px] after:w-full after:bg-primary after:scale-x-0 after:origin-right hover:after:scale-x-100 hover:after:origin-left after:transition-transform after:duration-300 after:ease-out focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-on-primary rounded-sm"
        href="#projects"
      >Projects</a>
      <a
        class="font-label-sm text-label-sm uppercase tracking-widest text-secondary hover:text-primary transition-colors relative after:absolute after:left-0 after:-bottom-1 after:h-[1px] after:w-full after:bg-primary after:scale-x-0 after:origin-right hover:after:scale-x-100 hover:after:origin-left after:transition-transform after:duration-300 after:ease-out focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-on-primary rounded-sm"
        href="#certificates"
      >Certificates</a>
      
      <button
        id="theme-toggle"
        class="text-secondary hover:text-primary transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded-sm p-1"
        aria-label="Toggle theme"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
      </button>

      <a
        class="hidden md:inline-flex items-center justify-center px-6 py-2.5 border border-primary/20 text-primary bg-transparent font-label-sm uppercase tracking-[0.15em] rounded-sm hover:bg-primary hover:text-on-primary hover:scale-[1.02] transition-all duration-500 ease-out shadow-sm hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-on-primary rounded-sm"
        href="#contact"
      >
        <span class="relative z-10">Connect</span>
      </a>
    </nav>
    <div class="md:hidden flex items-center space-x-4">
      <button
        id="theme-toggle-mobile"
        class="text-secondary hover:text-primary transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded-sm p-1"
        aria-label="Toggle theme"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
      </button>
      <button
        class="text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded-sm p-1"
        aria-label="Toggle Menu"
      >
        <span class="material-symbols-outlined text-2xl" aria-hidden="true">menu</span>
      </button>
    </div>
  </div>
</header>
