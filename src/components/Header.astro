---
import profileData from '../data/profile.json';
import { Button } from './ui/button.tsx';
---

<header class="header-main w-full fixed top-0 z-50 transition-all duration-300 py-6">
  {/* GSAP Blur background layer */}
  <div class="header-bg absolute inset-0 bg-surface/0 backdrop-blur-none z-[-1] border-b border-transparent transition-colors duration-500"></div>

  <div class="flex justify-between items-center w-full px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto">
    <a
      class="nav-item opacity-0 font-logo text-2xl font-bold tracking-[0.2em] text-primary uppercase focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded-sm"
      href="#"
    >
      {profileData.name}
    </a>
    
{/* Desktop nav replaced by bottom Glass Dock */}

    {/* Mobile Menu Toggle */}
    <div class="md:hidden flex items-center">
      <button class="nav-item opacity-0 text-primary p-2 focus-visible:outline-none" aria-label="Toggle Menu">
        <span class="material-symbols-outlined text-2xl" aria-hidden="true">menu</span>
      </button>
    </div>
  </div>
</header>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Initial load stagger animation for nav items
  gsap.to('.nav-item', {
    opacity: 1,
    y: 0,
    duration: 1,
    stagger: 0.1,
    ease: 'power3.out',
    delay: 0.5,
    clearProps: 'transform' // clear only transforms, keep inline opacity: 1
  });

  // GSAP sticky nav blur/opacity shift on scroll
  const headerBg = document.querySelector('.header-bg');
  const headerMain = document.querySelector('.header-main');
  
  if (headerBg && headerMain) {
    ScrollTrigger.create({
      start: 'top -50',
      end: 99999, // keep active forever
      toggleClass: {className: 'scrolled', targets: '.header-main'},
      onUpdate: (self) => {
        // When scrolled past 50px, add blur and background
        if (self.direction === 1 || self.progress > 0) {
          gsap.to(headerBg, {
            backgroundColor: 'rgba(5, 5, 5, 0.85)',
            backdropFilter: 'blur(16px)',
            borderBottomColor: 'rgba(34, 34, 34, 0.5)',
            duration: 0.4
          });
          gsap.to(headerMain, {
            paddingTop: '16px',
            paddingBottom: '16px',
            duration: 0.4
          });
        } else {
          // Top of page
          gsap.to(headerBg, {
            backgroundColor: 'rgba(5, 5, 5, 0)',
            backdropFilter: 'blur(0px)',
            borderBottomColor: 'transparent',
            duration: 0.4
          });
          gsap.to(headerMain, {
            paddingTop: '24px',
            paddingBottom: '24px',
            duration: 0.4
          });
        }
      }
    });
  }
</script>
