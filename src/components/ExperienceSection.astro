---
import experienceData from '../data/experience.json';
---

<section
  class="animate-on-scroll w-full px-margin-mobile md:px-margin-desktop py-section-gap max-w-container-max mx-auto border-t border-outline-variant scroll-mt-32"
  id="experience"
>
  <div class="grid grid-cols-1 md:grid-cols-12 gap-gutter mb-16">
    <div class="md:col-span-4">
      <h2 class="font-headline-md text-primary">
        Professional Experience
      </h2>
    </div>
  </div>
  <div class="flex flex-col gap-4 relative">
    {experienceData.workExperience.map((job) => (
      <div
        class="grid grid-cols-1 md:grid-cols-12 gap-gutter py-8 md:py-10 border border-outline-variant/10 hover:border-outline-variant/40 hover:bg-surface/40 backdrop-blur-sm hover:shadow-[0_10px_30px_rgba(0,0,0,0.3)] transition-all duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] -mx-4 px-6 rounded-2xl hover:-translate-y-1 cursor-pointer group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
        tabindex="0"
        role="button"
      >
        <div class="md:col-span-3 flex flex-col md:pr-4">
          <span class="font-label-sm text-label-sm text-primary uppercase tracking-widest mb-2 font-medium">
            {job.period}
          </span>
          <span class="font-body-md text-body-md text-secondary group-hover:text-primary transition-colors">
            {job.company}
          </span>
        </div>
        <div class="hidden md:flex md:col-span-1 justify-center relative">
          <div class="absolute top-0 bottom-0 w-[1px] group-hover:bg-primary/50 transition-colors bg-outline-variant/40">
          </div>
          <div class="absolute top-1 w-3 h-3 rounded-full bg-surface border-2 border-outline-variant/60 group-hover:border-primary group-hover:bg-primary transition-colors z-10">
          </div>
        </div>
        <div class="md:col-span-8 md:pl-2">
          <h3 class="font-headline-md text-headline-md text-primary mb-4 flex items-center justify-between">
            <span>{job.role}</span>
            <div class="w-8 h-8 rounded-full bg-white/[0.04] border border-white/10 flex items-center justify-center text-white/50 opacity-0 group-hover:opacity-100 group-hover:text-white group-hover:bg-white/[0.1] group-hover:border-white/30 group-hover:scale-110 transition-all duration-300 transform -translate-x-2 group-hover:translate-x-0">
              <span class="material-symbols-outlined text-base" aria-hidden="true">arrow_forward</span>
            </div>
          </h3>
          <p class="font-body-md text-on-background/80 mb-6 font-light leading-relaxed">
            {job.summary}
          </p>
          <ul class="list-disc list-inside space-y-2 mb-2 hidden group-hover:block transition-all duration-500 font-body-md text-secondary text-sm">
            {job.achievements.map((achievement) => (
              <li>{achievement}</li>
            ))}
          </ul>
        </div>
      </div>
    ))}
  </div>
</section>
