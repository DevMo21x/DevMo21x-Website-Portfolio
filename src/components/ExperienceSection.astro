---
import experienceData from '../data/experience.json';
---

<section class="w-full px-margin-mobile md:px-margin-desktop py-section-gap max-w-container-max mx-auto border-t border-outline-variant/50 relative" id="experience">
  
  <div class="mb-24 md:w-2/3 experience-header">
    <h2 class="font-headline-md text-[6vw] md:text-7xl text-primary font-bold tracking-tight mb-6">
      Experience
    </h2>
    <p class="font-body-lg text-secondary text-xl font-light">
      A timeline of professional roles, highlighting backend scale, cloud transitions, and architectural leadership.
    </p>
  </div>

  <div class="flex flex-col md:flex-row gap-16 relative experience-container items-start">
    
    {/* Left Side: Timeline List */}
    <div class="w-full md:w-1/2 flex flex-col gap-8 md:gap-32 relative z-10 timeline-left">
      <div class="absolute left-[11px] top-4 bottom-0 w-[1px] bg-outline-variant/30 hidden md:block"></div>
      
      {experienceData.workExperience.map((job, index) => (
        <div class="job-item flex gap-8 group cursor-default" data-index={index}>
          
          <div class="hidden md:flex flex-col items-center mt-2 relative z-10">
            <div class="w-6 h-6 rounded-full bg-surface border-4 border-surface-container-highest group-hover:border-primary transition-colors duration-500 flex-shrink-0 indicator-dot"></div>
          </div>

          <div class="flex flex-col w-full">
            <span class="font-label-sm text-primary uppercase tracking-[0.2em] mb-3 text-xs md:text-sm">
              {job.period}
            </span>
            <h3 class="font-headline-md text-3xl md:text-4xl text-primary mb-2 font-bold group-hover:text-surface-tint transition-colors">
              {job.role}
            </h3>
            <span class="font-body-md text-secondary text-lg mb-6">
              {job.company}
            </span>
            
            {/* Mobile shows content directly under */}
            <div class="md:hidden">
              <p class="font-body-md text-on-background/80 mb-6 font-light leading-relaxed">
                {job.summary}
              </p>
              <ul class="list-none space-y-4 font-body-md text-secondary font-light">
                {job.achievements.map((achievement) => (
                  <li class="relative pl-6 before:content-[''] before:absolute before:left-0 before:top-2.5 before:w-1.5 before:h-1.5 before:bg-outline-variant before:rounded-full">
                    {achievement}
                  </li>
                ))}
              </ul>
            </div>
          </div>

        </div>
      ))}
    </div>

    {/* Right Side: Pinned Details (Desktop Only) */}
    <div class="hidden md:block w-full md:w-1/2 h-[60vh] sticky top-[20vh] timeline-right bg-surface-container-highest/20 rounded-3xl p-12 border border-outline-variant/20 overflow-hidden backdrop-blur-sm">
      {experienceData.workExperience.map((job, index) => (
        <div class="job-detail absolute inset-12 flex flex-col opacity-0 pointer-events-none transition-opacity" data-index={index}>
          <div class="w-12 h-12 bg-primary/10 text-primary rounded-xl flex items-center justify-center mb-8 border border-primary/20">
            <span class="material-symbols-outlined text-2xl" aria-hidden="true">work</span>
          </div>
          <p class="font-body-md text-on-background/90 mb-8 font-light leading-relaxed text-lg">
            {job.summary}
          </p>
          <ul class="list-none space-y-5 font-body-md text-secondary font-light">
            {job.achievements.map((achievement) => (
              <li class="relative pl-6 before:content-[''] before:absolute before:left-0 before:top-2.5 before:w-1.5 before:h-1.5 before:bg-primary/50 before:rounded-full">
                {achievement}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Section Header Reveal
  gsap.fromTo('.experience-header', 
    { y: 50, opacity: 0 },
    {
      y: 0,
      opacity: 1,
      duration: 1,
      ease: 'power3.out',
      scrollTrigger: {
        trigger: '.experience-header',
        start: 'top 80%',
      }
    }
  );

  // Desktop Pinning and Cross-fade logic
  const isDesktop = window.matchMedia('(min-width: 768px)').matches;

  if (isDesktop) {
    const jobItems = document.querySelectorAll('.job-item');
    const jobDetails = document.querySelectorAll('.job-detail');

    // Make the first item visible immediately
    if (jobDetails.length > 0) {
      gsap.set(jobDetails[0], { opacity: 1, pointerEvents: 'auto', y: 0 });
      gsap.set(jobItems[0].querySelector('.indicator-dot'), { borderColor: '#ffffff', backgroundColor: '#ffffff' });
    }

    jobItems.forEach((item, index) => {
      const dot = item.querySelector('.indicator-dot');

      ScrollTrigger.create({
        trigger: item,
        start: 'top 50%',
        end: 'bottom 50%',
        onEnter: () => activateDetail(index),
        onEnterBack: () => activateDetail(index),
      });

      function activateDetail(activeIndex: number) {
        // Reset all dots
        jobItems.forEach(i => {
          gsap.to(i.querySelector('.indicator-dot'), { 
            borderColor: 'var(--surface-container-highest)', // approximation
            backgroundColor: 'transparent',
            duration: 0.3 
          });
        });
        
        // Highlight active dot
        gsap.to(dot, { borderColor: '#ffffff', backgroundColor: '#ffffff', duration: 0.3 });

        // Crossfade details
        jobDetails.forEach((detail, i) => {
          if (i === activeIndex) {
            gsap.to(detail, { 
              opacity: 1, 
              pointerEvents: 'auto', 
              y: 0, 
              duration: 0.5, 
              ease: 'power2.out',
              delay: 0.1 
            });
          } else {
            gsap.to(detail, { 
              opacity: 0, 
              pointerEvents: 'none', 
              y: 20, 
              duration: 0.3, 
              ease: 'power2.in' 
            });
          }
        });
      }
    });
  } else {
    // Mobile basic reveal
    gsap.utils.toArray('.job-item').forEach((item: any) => {
      gsap.fromTo(item, 
        { y: 30, opacity: 0 },
        {
          y: 0,
          opacity: 1,
          duration: 0.8,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: item,
            start: 'top 85%',
          }
        }
      );
    });
  }
</script>
