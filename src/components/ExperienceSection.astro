---
import experienceData from '../data/experience.json';
---

<section class="w-full px-margin-mobile md:px-margin-desktop py-section-gap md:py-16 md:min-h-screen md:flex md:flex-col md:justify-center max-w-container-max mx-auto border-t border-outline-variant/50 relative" id="experience">
  
  <div class="mb-24 md:mb-12 md:w-2/3 experience-header">
    <h2 class="font-headline-md text-[6vw] md:text-7xl text-primary font-bold tracking-tight mb-6">
      Experience
    </h2>
    <p class="font-body-lg text-secondary text-xl font-light">
      A timeline of professional roles, highlighting backend scale, cloud transitions, and architectural leadership.
    </p>
  </div>

  <div class="flex flex-col md:flex-row gap-16 relative experience-container items-start">
    
    {/* Left Side: Timeline List */}
    <div class="w-full md:w-1/2 flex flex-col gap-8 md:gap-12 relative z-10 timeline-left">
      <div class="absolute left-[11px] top-4 bottom-0 w-[1px] bg-outline-variant/30 hidden md:block"></div>
      
      {experienceData.workExperience.map((job, index) => (
        <div class="job-item flex gap-8 group cursor-default transition-all duration-300" data-index={index}>
          
          <div class="hidden md:flex flex-col items-center mt-2 relative z-10">
            <div class="w-6 h-6 rounded-full bg-surface border-4 border-surface-container-highest group-hover:border-primary transition-all duration-500 flex-shrink-0 indicator-dot"></div>
          </div>

          <div class="flex flex-col w-full">
            <span class="font-label-sm text-primary uppercase tracking-[0.2em] mb-3 text-xs md:text-sm">
              {job.period}
            </span>
            <h3 class="font-headline-md text-2xl md:text-3xl text-primary mb-2 font-bold group-hover:text-surface-tint transition-colors">
              {job.role}
            </h3>
            <span class="font-body-md text-secondary text-lg mb-6 md:mb-0">
              {job.company}
            </span>
            
            {/* Mobile shows content directly under */}
            <div class="md:hidden">
              <p class="font-body-md text-on-background/80 mb-6 font-light leading-relaxed">
                {job.summary}
              </p>
              <ul class="list-none space-y-4 font-body-md text-secondary font-light">
                {job.achievements.map((achievement) => (
                  <li class="relative pl-6 before:content-[''] before:absolute before:left-0 before:top-2.5 before:w-1.5 before:h-1.5 before:bg-outline-variant before:rounded-full">
                    {achievement}
                  </li>
                ))}
              </ul>
            </div>
          </div>

        </div>
      ))}
    </div>

    {/* Right Side: Pinned Details (Desktop Only) */}
    <div class="hidden md:block w-full md:w-1/2 h-[460px] timeline-right bg-surface-container-highest/20 rounded-3xl p-10 border border-outline-variant/20 overflow-hidden backdrop-blur-sm relative">
      {experienceData.workExperience.map((job, index) => (
        <div class="job-detail absolute inset-10 flex flex-col opacity-0 pointer-events-none will-change-transform" data-index={index}>
          <div class="detail-icon w-12 h-12 bg-primary/10 text-primary rounded-xl flex items-center justify-center mb-6 border border-primary/20 shadow-[0_0_15px_rgba(255,255,255,0.05)] flex-shrink-0">
            <span class="material-symbols-outlined text-2xl" aria-hidden="true">work</span>
          </div>
          <p class="detail-summary font-body-md text-on-background/90 mb-6 font-light leading-relaxed text-lg">
            {job.summary}
          </p>
          <ul class="detail-achievements list-none space-y-3.5 font-body-md text-secondary font-light">
            {job.achievements.map((achievement) => (
              <li class="achievement-item relative pl-6 before:content-[''] before:absolute before:left-0 before:top-2.5 before:w-1.5 before:h-1.5 before:bg-primary/60 before:rounded-full transition-colors leading-relaxed">
                {achievement}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Section Header Reveal
  gsap.fromTo('.experience-header', 
    { y: 40, opacity: 0 },
    {
      y: 0,
      opacity: 1,
      duration: 0.8,
      ease: 'power3.out',
      scrollTrigger: {
        trigger: '.experience-header',
        start: 'top 85%',
      }
    }
  );

  // Desktop Pinning and Smooth Cross-fade logic
  let mm = gsap.matchMedia();

  mm.add("(min-width: 768px)", () => {
    const jobItems = document.querySelectorAll('.job-item');
    const jobDetails = document.querySelectorAll('.job-detail');
    const numRoles = jobItems.length;

    // Initial state
    if (jobDetails.length > 0) {
      jobItems.forEach((item, i) => {
        const dot = item.querySelector('.indicator-dot');
        const detail = jobDetails[i];
        const icon = detail.querySelector('.detail-icon');
        const summary = detail.querySelector('.detail-summary');
        const bullets = detail.querySelectorAll('.achievement-item');

        if (i === 0) {
          gsap.set(detail, { opacity: 1, pointerEvents: 'auto', y: 0 });
          gsap.set([icon, summary, ...bullets], { opacity: 1, y: 0 });
          gsap.set(dot, { borderColor: '#ffffff', backgroundColor: '#ffffff', boxShadow: '0 0 14px rgba(255,255,255,0.7)' });
          gsap.set(item, { opacity: 1, x: 6 });
        } else {
          gsap.set(detail, { opacity: 0, pointerEvents: 'none', y: 20 });
          gsap.set([icon, summary, ...bullets], { opacity: 0, y: 12 });
          gsap.set(dot, { borderColor: 'var(--surface-container-highest)', backgroundColor: 'transparent', boxShadow: 'none' });
          gsap.set(item, { opacity: 0.35, x: 0 });
        }
      });
    }

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: '#experience',
        start: 'top top',
        end: () => "+=" + (numRoles * 900), // Generous track for relaxed scroll
        pin: true,
        pinSpacing: true,
        scrub: 1.4, // Rich inertial buffering
        anticipatePin: 1,
        invalidateOnRefresh: true
      }
    });

    // 1. Initial Lead-in Buffer: Let the user smoothly settle into the pinned section
    tl.to({}, { duration: 0.8 });

    // Smoothly sequence between roles with staggered bullet points
    for (let i = 0; i < numRoles - 1; i++) {
      const currentItem = jobItems[i];
      const currentDot = currentItem.querySelector('.indicator-dot');
      const currentDetail = jobDetails[i];
      const currentElements = [
        currentDetail.querySelector('.detail-icon'),
        currentDetail.querySelector('.detail-summary'),
        ...currentDetail.querySelectorAll('.achievement-item')
      ];
      
      const nextItem = jobItems[i + 1];
      const nextDot = nextItem.querySelector('.indicator-dot');
      const nextDetail = jobDetails[i + 1];
      const nextIcon = nextDetail.querySelector('.detail-icon');
      const nextSummary = nextDetail.querySelector('.detail-summary');
      const nextBullets = nextDetail.querySelectorAll('.achievement-item');

      const stepLabel = `step${i}`;

      // Fade & drift out current role
      tl.to(currentDetail, {
        opacity: 0,
        y: -18,
        pointerEvents: 'none',
        duration: 1.2,
        ease: 'power2.inOut'
      }, stepLabel)
      .to(currentElements, {
        opacity: 0,
        y: -8,
        stagger: 0.04,
        duration: 0.9,
        ease: 'power2.inOut'
      }, stepLabel)
      .to(currentDot, {
        borderColor: 'var(--surface-container-highest)',
        backgroundColor: 'transparent',
        boxShadow: 'none',
        duration: 1,
        ease: 'power2.inOut'
      }, stepLabel)
      .to(currentItem, {
        opacity: 0.35,
        x: 0,
        duration: 1,
        ease: 'power2.inOut'
      }, stepLabel)

      // Fade & stagger in next role
      .to(nextDetail, {
        opacity: 1,
        y: 0,
        pointerEvents: 'auto',
        duration: 1.2,
        ease: 'power2.out'
      }, `${stepLabel}+=0.3`)
      .to(nextDot, {
        borderColor: '#ffffff',
        backgroundColor: '#ffffff',
        boxShadow: '0 0 14px rgba(255,255,255,0.7)',
        duration: 1,
        ease: 'power2.out'
      }, `${stepLabel}+=0.3`)
      .to(nextItem, {
        opacity: 1,
        x: 6,
        duration: 1,
        ease: 'power2.out'
      }, `${stepLabel}+=0.3`)
      .to([nextIcon, nextSummary], {
        opacity: 1,
        y: 0,
        stagger: 0.08,
        duration: 0.9,
        ease: 'power2.out'
      }, `${stepLabel}+=0.4`)
      .to(nextBullets, {
        opacity: 1,
        y: 0,
        stagger: 0.12,
        duration: 1,
        ease: 'power2.out'
      }, `${stepLabel}+=0.5`);
        
      // Reading dwell pause between roles
      tl.to({}, { duration: 0.8 }); 
    }

    // 2. Final Lead-out Buffer: Hold the final role comfortably before releasing page scroll
    tl.to({}, { duration: 0.8 });
  });

  mm.add("(max-width: 767px)", () => {
    // Mobile basic reveal
    gsap.utils.toArray('.job-item').forEach((item: any) => {
      gsap.fromTo(item, 
        { y: 30, opacity: 0 },
        {
          y: 0,
          opacity: 1,
          duration: 0.8,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: item,
            start: 'top 85%',
          }
        }
      );
    });
  });
</script>
