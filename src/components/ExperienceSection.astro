---
import experienceData from '../data/experience.json';
---

<section
  class="animate-on-scroll w-full px-margin-mobile md:px-margin-desktop py-section-gap max-w-container-max mx-auto border-t border-outline-variant scroll-mt-32"
  id="experience"
>
  <div class="grid grid-cols-1 md:grid-cols-12 gap-gutter mb-16">
    <div class="md:col-span-4">
      <h2 class="font-body-lg text-3xl font-light tracking-tight text-primary">
        Professional Experience
      </h2>
    </div>
  </div>
  <div class="flex flex-col gap-4 relative">
    {experienceData.workExperience.map((job) => (
      <div
        class="grid grid-cols-1 md:grid-cols-12 gap-gutter py-8 md:py-12 border border-transparent hover:border-outline-variant/20 hover:bg-surface hover:shadow-lg transition-all duration-500 ease-out -mx-4 px-4 rounded-2xl hover:-translate-y-1 hover:scale-[1.02] cursor-pointer group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
        tabindex="0"
        role="button"
      >
        <div class="md:col-span-3 flex flex-col md:pr-4">
          <span class="font-label-sm text-label-sm text-primary uppercase tracking-widest mb-2">
            {job.period}
          </span>
          <span class="font-body-md text-body-md text-secondary group-hover:text-primary transition-colors">
            {job.company}
          </span>
        </div>
        <div class="hidden md:flex md:col-span-1 justify-center relative">
          <div class="absolute top-0 bottom-0 w-[1px] group-hover:bg-primary/50 transition-colors bg-outline-variant">
          </div>
          <div class="absolute top-1 w-3 h-3 rounded-full bg-surface border-2 border-outline-variant group-hover:border-primary group-hover:bg-primary transition-colors z-10">
          </div>
        </div>
        <div class="md:col-span-8 md:pl-2">
          <h3 class="font-headline-md text-headline-md text-primary mb-4 flex items-center justify-between">
            <span>{job.role}</span>
            <span class="material-symbols-outlined text-outline group-hover:text-primary opacity-0 group-hover:opacity-100 transition-all transform -translate-x-4 group-hover:translate-x-0" aria-hidden="true">arrow_forward</span>
          </h3>
          <p class="font-body-lg text-body-lg text-secondary mb-6 leading-relaxed">
            {job.summary}
          </p>
          <ul class="list-disc list-inside space-y-2 mb-6 hidden group-hover:block transition-all duration-500 font-body-md text-secondary">
            {job.achievements.map((achievement) => (
              <li>{achievement}</li>
            ))}
          </ul>
        </div>
      </div>
    ))}
  </div>
</section>
