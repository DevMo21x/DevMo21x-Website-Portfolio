---
import projectsData from '../data/projects.json';
import { Card, CardHeader, CardTitle, CardDescription, CardContent, CardFooter } from './ui/card.tsx';

interface TechMeta {
  icon: string;
  isMaterial: boolean;
  color: string;
  glow: string;
}

// Helper to map tags to rich devicon classes, vibrant material symbols, and authentic brand colors
const getTechMeta = (tag: string): TechMeta => {
  const t = tag.toLowerCase();
  
  if (t.includes('typescript') || t === 'ts') {
    return { icon: 'devicon-typescript-plain colored', isMaterial: false, color: '#3178C6', glow: 'rgba(49, 120, 198, 0.45)' };
  }
  if (t.includes('javascript') || t === 'js') {
    return { icon: 'devicon-javascript-plain colored', isMaterial: false, color: '#F7DF1E', glow: 'rgba(247, 223, 30, 0.45)' };
  }
  if (t.includes('react')) {
    return { icon: 'devicon-react-original colored', isMaterial: false, color: '#61DAFB', glow: 'rgba(97, 218, 251, 0.45)' };
  }
  if (t.includes('node')) {
    return { icon: 'devicon-nodejs-plain colored', isMaterial: false, color: '#5FA04E', glow: 'rgba(95, 160, 78, 0.45)' };
  }
  if (t.includes('docker')) {
    return { icon: 'devicon-docker-plain colored', isMaterial: false, color: '#2496ED', glow: 'rgba(36, 150, 237, 0.45)' };
  }
  if (t.includes('kubernetes')) {
    return { icon: 'devicon-kubernetes-plain colored', isMaterial: false, color: '#326CE5', glow: 'rgba(50, 108, 229, 0.45)' };
  }
  if (t.includes('go') || t === 'golang') {
    return { icon: 'devicon-go-plain colored', isMaterial: false, color: '#00ADD8', glow: 'rgba(0, 173, 216, 0.45)' };
  }
  if (t.includes('rust')) {
    return { icon: 'devicon-rust-plain colored', isMaterial: false, color: '#DEA584', glow: 'rgba(222, 165, 132, 0.45)' };
  }
  if (t.includes('kafka')) {
    return { icon: 'devicon-apachekafka-original colored', isMaterial: false, color: '#E05A47', glow: 'rgba(224, 90, 71, 0.45)' };
  }
  if (t.includes('redis')) {
    return { icon: 'devicon-redis-plain colored', isMaterial: false, color: '#FF4438', glow: 'rgba(255, 68, 56, 0.45)' };
  }
  if (t.includes('prometheus')) {
    return { icon: 'devicon-prometheus-original colored', isMaterial: false, color: '#E6522C', glow: 'rgba(230, 82, 44, 0.45)' };
  }
  if (t.includes('postgresql') || t.includes('postgres') || t.includes('sql')) {
    return { icon: 'devicon-postgresql-plain colored', isMaterial: false, color: '#4169E1', glow: 'rgba(65, 105, 225, 0.45)' };
  }
  if (t.includes('css')) {
    return { icon: 'devicon-css3-plain colored', isMaterial: false, color: '#264DE4', glow: 'rgba(38, 77, 228, 0.45)' };
  }
  if (t.includes('html') || t.includes('canvas')) {
    return { icon: 'devicon-html5-plain colored', isMaterial: false, color: '#E34F26', glow: 'rgba(227, 79, 38, 0.45)' };
  }
  if (t.includes('python')) {
    return { icon: 'devicon-python-plain colored', isMaterial: false, color: '#3776AB', glow: 'rgba(55, 118, 171, 0.45)' };
  }
  if (t.includes('graphql')) {
    return { icon: 'devicon-graphql-plain colored', isMaterial: false, color: '#E10098', glow: 'rgba(225, 0, 152, 0.45)' };
  }
  if (t.includes('aws') || t.includes('amazon')) {
    return { icon: 'devicon-amazonwebservices-plain-wordmark colored', isMaterial: false, color: '#FF9900', glow: 'rgba(255, 153, 0, 0.45)' };
  }
  if (t.includes('websocket')) {
    return { icon: 'sync_alt', isMaterial: true, color: '#00E5FF', glow: 'rgba(0, 229, 255, 0.5)' };
  }
  if (t.includes('llm') || t.includes('ai')) {
    return { icon: 'smart_toy', isMaterial: true, color: '#10A37F', glow: 'rgba(16, 163, 127, 0.5)' };
  }
  if (t.includes('vector')) {
    return { icon: 'hub', isMaterial: true, color: '#A855F7', glow: 'rgba(168, 85, 247, 0.5)' };
  }
  if (t.includes('audio') || t.includes('sound')) {
    return { icon: 'graphic_eq', isMaterial: true, color: '#EC4899', glow: 'rgba(236, 72, 153, 0.5)' };
  }
  if (t.includes('dsp') || t.includes('wave')) {
    return { icon: 'waves', isMaterial: true, color: '#06B6D4', glow: 'rgba(6, 182, 212, 0.5)' };
  }
  if (t.includes('auth') || t.includes('passkey')) {
    return { icon: 'fingerprint', isMaterial: true, color: '#38BDF8', glow: 'rgba(56, 189, 248, 0.5)' };
  }
  if (t.includes('crypto') || t.includes('security') || t.includes('vault')) {
    return { icon: 'lock', isMaterial: true, color: '#10B981', glow: 'rgba(16, 185, 129, 0.5)' };
  }
  if (t.includes('oauth')) {
    return { icon: 'vpn_key', isMaterial: true, color: '#F59E0B', glow: 'rgba(245, 158, 11, 0.5)' };
  }
  if (t.includes('cli') || t.includes('terminal')) {
    return { icon: 'terminal', isMaterial: true, color: '#4ADE80', glow: 'rgba(74, 222, 128, 0.5)' };
  }
  if (t.includes('async') || t.includes('io')) {
    return { icon: 'bolt', isMaterial: true, color: '#FBBF24', glow: 'rgba(251, 191, 36, 0.5)' };
  }
  if (t.includes('component') || t.includes('widget')) {
    return { icon: 'extension', isMaterial: true, color: '#29B6F6', glow: 'rgba(41, 182, 246, 0.5)' };
  }
  if (t.includes('a11y') || t.includes('accessibility')) {
    return { icon: 'accessibility_new', isMaterial: true, color: '#34D399', glow: 'rgba(52, 211, 153, 0.5)' };
  }
  if (t.includes('web apis') || t.includes('api')) {
    return { icon: 'api', isMaterial: true, color: '#F97316', glow: 'rgba(249, 115, 22, 0.5)' };
  }

  return { icon: 'code', isMaterial: true, color: '#CBD5E1', glow: 'rgba(203, 213, 225, 0.35)' };
};
---

<section class="w-full px-margin-mobile md:px-margin-desktop py-section-gap max-w-container-max mx-auto border-t border-outline-variant/50 scroll-mt-32" id="projects">
  
  <div class="mb-24 md:w-2/3 project-header">
    <h2 class="font-headline-md text-[6vw] md:text-7xl text-primary font-bold tracking-tight mb-6 text-balance">
      Selected Work
    </h2>
    <p class="font-body-lg text-secondary text-xl font-light">
      A collection of recent projects spanning cloud infrastructure, backend systems, and frontend experiences.
    </p>
  </div>

  <div class="flex flex-col gap-32">
    {projectsData.projects.map((project, index) => {
      // Alternate layout: even items image left, odd items image right
      const isEven = index % 2 === 0;

      return (
        <a 
          href={project.demoUrl || project.repoUrl} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="project-card block focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded-3xl"
        >
          <Card className={`relative overflow-visible bg-transparent border-0 shadow-none flex flex-col ${isEven ? 'md:flex-row' : 'md:flex-row-reverse'} gap-12 lg:gap-24 items-center group`}>
            
            {/* Visual Side */}
            <div class="w-full md:w-3/5 aspect-[4/3] rounded-3xl overflow-hidden relative border border-outline-variant/30 bg-surface-container-highest z-10 project-visual-container">
              <div class="absolute inset-0 bg-surface-tint opacity-0 group-hover:opacity-5 transition-opacity duration-700 z-20"></div>
              
              {/* GSAP Target for Image/Pattern Scale */}
              <div class="project-visual w-full h-full flex items-center justify-center bg-gradient-to-br from-surface-container-highest to-surface-container-low relative">
                <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-primary/5 via-transparent to-transparent opacity-50"></div>
                
                {project.featured && (
                  <span class="absolute top-6 left-6 font-label-sm text-xs text-primary uppercase tracking-[0.2em] px-4 py-1.5 rounded-full border border-primary/20 bg-primary/5 backdrop-blur-md">
                    Featured
                  </span>
                )}

                <span class="material-symbols-outlined text-8xl text-outline-variant opacity-30 drop-shadow-2xl" aria-hidden="true">
                  {index % 2 === 0 ? 'terminal' : 'dns'}
                </span>
              </div>
            </div>

            {/* Content Side */}
            <div class="w-full md:w-2/5 flex flex-col justify-center">
              <div class="flex items-center justify-between mb-8">
                <span class="font-label-sm text-secondary uppercase tracking-[0.2em]">0{index + 1}</span>
                <div class="project-arrow w-12 h-12 rounded-full border border-outline-variant flex items-center justify-center text-secondary">
                  <span class="material-symbols-outlined transform -rotate-45 text-xl" aria-hidden="true">arrow_forward</span>
                </div>
              </div>
              
              <CardTitle className="text-4xl md:text-5xl font-bold mb-6 text-primary group-hover:text-surface-tint transition-colors duration-500">
                {project.title}
              </CardTitle>
              
              <CardDescription className="text-lg font-light text-on-background/80 mb-10 leading-relaxed">
                {project.description || project.summary}
              </CardDescription>

              <CardFooter className="p-0 flex flex-wrap gap-2.5">
                {project.tags.map((tag) => {
                  const tech = getTechMeta(tag);
                  return (
                    <span 
                      class="tech-pill relative px-3.5 py-1.5 bg-surface-container-highest/60 border border-outline-variant/40 rounded-full flex items-center gap-2 text-xs md:text-sm font-medium text-on-surface/90 backdrop-blur-sm cursor-default"
                      style={`--tech-color: ${tech.color}; --tech-glow: ${tech.glow};`}
                    >
                      {tech.isMaterial ? (
                        <span 
                          class="material-symbols-outlined text-base md:text-lg tech-icon transition duration-300 flex-shrink-0" 
                          style={`color: ${tech.color};`}
                          aria-hidden="true"
                        >
                          {tech.icon}
                        </span>
                      ) : (
                        <i 
                          class={`${tech.icon} text-base md:text-lg tech-icon transition duration-300 flex-shrink-0`} 
                          aria-hidden="true"
                        ></i>
                      )}
                      <span class="tracking-tight text-secondary/90 transition-colors duration-300 tech-label">{tag}</span>
                    </span>
                  );
                })}
              </CardFooter>
            </div>
            
          </Card>
        </a>
      );
    })}
  </div>
</section>

<style>
  .tech-pill {
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.3s ease,
                background-color 0.3s ease,
                box-shadow 0.3s ease;
  }
  
  .tech-pill:hover {
    border-color: var(--tech-color) !important;
    background-color: rgba(255, 255, 255, 0.08) !important;
    box-shadow: 0 0 16px -1px var(--tech-glow), inset 0 0 10px -2px var(--tech-glow) !important;
    transform: translateY(-2px) scale(1.04);
  }

  .tech-pill:hover .tech-icon {
    transform: scale(1.2);
    filter: drop-shadow(0 0 8px var(--tech-color));
  }

  .tech-pill:hover .tech-label {
    color: #ffffff !important;
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Section Header Reveal
  gsap.fromTo('.project-header', 
    { y: 50, opacity: 0 },
    {
      y: 0,
      opacity: 1,
      duration: 1,
      ease: 'power3.out',
      scrollTrigger: {
        trigger: '.project-header',
        start: 'top 80%',
      }
    }
  );

  // Project Cards Reveal & Hover setup
  const projectCards = document.querySelectorAll('.project-card');

  projectCards.forEach((card, index) => {
    const visualContainer = card.querySelector('.project-visual-container');
    const visual = card.querySelector('.project-visual');
    const arrow = card.querySelector('.project-arrow');
    const contentSide = card.querySelector('.CardTitle')?.parentElement;

    // Scroll Reveal Timeline
    gsap.fromTo(visualContainer,
      { y: 100, opacity: 0, scale: 0.95 },
      {
        y: 0,
        opacity: 1,
        scale: 1,
        duration: 1.2,
        ease: 'power4.out',
        scrollTrigger: {
          trigger: card,
          start: 'top 85%',
        }
      }
    );

    gsap.fromTo(contentSide,
      { y: 50, opacity: 0 },
      {
        y: 0,
        opacity: 1,
        duration: 1,
        delay: 0.2,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: card,
          start: 'top 85%',
        }
      }
    );

    // Hover interactions
    if (visual && arrow) {
      card.addEventListener('mouseenter', () => {
        gsap.to(visual, {
          scale: 1.05,
          duration: 0.8,
          ease: 'power3.out'
        });
        gsap.to(arrow, {
          backgroundColor: '#ffffff',
          color: '#000000',
          borderColor: '#ffffff',
          rotate: 45,
          duration: 0.4,
          ease: 'back.out(2)'
        });
      });

      card.addEventListener('mouseleave', () => {
        gsap.to(visual, {
          scale: 1,
          duration: 0.8,
          ease: 'power3.out'
        });
        gsap.to(arrow, {
          backgroundColor: 'transparent',
          color: '#888888',
          borderColor: '#222222',
          rotate: 0,
          duration: 0.4,
          ease: 'power3.out'
        });
      });
    }
  });
</script>
