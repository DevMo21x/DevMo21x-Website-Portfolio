---
import projectsData from '../data/projects.json';

const featuredProject = projectsData.projects.find(p => p.featured) || projectsData.projects[0];
const otherProjects = projectsData.projects.filter(p => p.id !== featuredProject.id).slice(0, 4);

// Helper to map tags to devicon classes
const getIconForTag = (tag: string) => {
  const t = tag.toLowerCase();
  if (t.includes('kubernetes')) return 'devicon-kubernetes-plain';
  if (t.includes('aws') || t.includes('amazon')) return 'devicon-amazonwebservices-plain-wordmark';
  if (t.includes('terraform')) return 'devicon-terraform-plain';
  if (t.includes('go')) return 'devicon-go-plain';
  if (t.includes('docker')) return 'devicon-docker-plain';
  if (t.includes('rust')) return 'devicon-rust-plain';
  if (t.includes('node')) return 'devicon-nodejs-plain';
  if (t.includes('react')) return 'devicon-react-original';
  if (t.includes('css')) return 'devicon-css3-plain';
  if (t.includes('typescript') || t.includes('ts')) return 'devicon-typescript-plain';
  if (t.includes('python')) return 'devicon-python-plain';
  return ''; // Default or empty if no icon
};
---

<section
  class="animate-on-scroll w-full px-margin-mobile md:px-margin-desktop py-section-gap max-w-container-max mx-auto border-t border-outline-variant scroll-mt-32"
  id="projects"
>
  <div class="mb-16 flex items-center justify-between">
    <h2 class="font-headline-md text-primary">
      Selected Projects
    </h2>
  </div>

  <!-- Featured Project -->
  <div class="mb-gutter bg-surface/50 backdrop-blur-md p-8 md:p-16 rounded-3xl flex flex-col lg:flex-row gap-12 items-center border border-outline-variant/30 shadow-sm hover:shadow-[0_20px_60px_rgba(0,0,0,0.5)] hover:-translate-y-2 hover:bg-surface/80 hover:border-outline transition-all duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] group cursor-pointer">
    <div class="flex-1 w-full">
      <span class="font-label-sm text-label-sm text-secondary uppercase tracking-widest mb-6 block flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-primary inline-block"></span> Featured
      </span>
      <h3 class="font-headline-md md:text-5xl text-primary mb-6 group-hover:text-surface-tint transition-colors">
        {featuredProject.title}
      </h3>
      <p class="font-body-md text-on-background/80 mb-10 max-w-xl font-light leading-relaxed">
        {featuredProject.description}
      </p>
      <div class="flex flex-wrap gap-3 mb-10">
        {featuredProject.tags.map((tag) => {
          const icon = getIconForTag(tag);
          return (
            <span class="px-4 py-1.5 border border-outline-variant/50 text-secondary font-label-sm rounded-full flex items-center gap-2 hover:bg-surface-container-high transition-colors">
              {icon && <i class={`${icon} text-lg`} aria-hidden="true"></i>}
              {tag}
            </span>
          );
        })}
      </div>
      <a href={featuredProject.demoUrl || featuredProject.repoUrl} target="_blank" rel="noopener noreferrer" class="btn-luxury-primary !px-6 !py-2.5 text-xs group/btn inline-flex">
        <span>View Project</span>
        <span class="material-symbols-outlined text-sm transform group-hover/btn:translate-x-1 transition-transform duration-300" aria-hidden="true">arrow_forward</span>
      </a>
    </div>
    <div class="flex-1 w-full aspect-video bg-surface-container-highest rounded-2xl flex items-center justify-center border border-outline-variant/20 overflow-hidden relative">
      <!-- You could use an actual image tag here if featuredProject.image is a valid path -->
      <span class="material-symbols-outlined text-6xl text-outline-variant opacity-50 group-hover:scale-110 transition-transform duration-700" aria-hidden="true">cloud_queue</span>
    </div>
  </div>

  <!-- Grid of other projects -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-gutter">
    {otherProjects.map(project => (
      <a href={project.demoUrl || project.repoUrl} target="_blank" rel="noopener noreferrer" class="bg-surface/30 backdrop-blur-md p-8 md:p-10 rounded-3xl border border-outline-variant/30 shadow-sm hover:shadow-[0_20px_40px_rgba(0,0,0,0.4)] hover:-translate-y-2 hover:bg-surface/60 hover:border-outline transition-all duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] group cursor-pointer block focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary">
        <div class="flex justify-between items-start mb-12">
          <h4 class="font-headline-md text-headline-md text-primary group-hover:text-surface-tint transition-colors">
            {project.title}
          </h4>
          <div class="w-9 h-9 rounded-full bg-white/[0.04] border border-white/10 flex items-center justify-center text-white/60 group-hover:text-white group-hover:bg-white/[0.1] group-hover:border-white/30 group-hover:scale-110 transition-all duration-300">
            <span class="material-symbols-outlined text-lg transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform duration-300" aria-hidden="true">arrow_outward</span>
          </div>
        </div>
        <p class="font-body-md text-on-background/80 mb-8 font-light leading-relaxed">
          {project.summary}
        </p>
        <div class="flex flex-wrap gap-2">
          {project.tags.slice(0, 3).map((tag) => {
            const icon = getIconForTag(tag);
            return (
              <span class="px-3 py-1 bg-surface-container-low text-secondary font-label-sm rounded-md flex items-center gap-2">
                {icon && <i class={`${icon} text-base`} aria-hidden="true"></i>}
                {tag}
              </span>
            );
          })}
        </div>
      </a>
    ))}
  </div>

  <div class="mt-20 flex justify-center animate-on-scroll">
    <a
      class="btn-luxury-secondary !px-8 !py-4 group text-sm"
      href="https://github.com/DevMo21x"
      target="_blank"
      rel="noopener noreferrer"
    >
      <svg class="lucide lucide-github opacity-80 group-hover:opacity-100 transition-opacity" fill="none" height="18" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="18" aria-hidden="true"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.02c3.14-.35 6.5-1.4 6.5-7a4.6 4.6 0 0 0-1.3-3.2 4.1 4.1 0 0 0-.1-3.2s-1.1-.3-3.5 1.6a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.1 4.1 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 12.08c0 5.6 3.36 6.65 6.5 7a4.8 4.8 0 0 0-1 3.02v4"></path><path d="M9 18c-4.5 1.5-5-2.5-7-3"></path></svg>
      <span>Explore All Repositories</span>
      <span class="material-symbols-outlined text-sm transform group-hover:translate-x-1 transition-transform duration-300" aria-hidden="true">arrow_forward</span>
    </a>
  </div>
</section>
