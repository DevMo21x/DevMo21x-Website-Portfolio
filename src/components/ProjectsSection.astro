---
import projectsData from '../data/projects.json';

const featuredProject = projectsData.projects.find(p => p.featured) || projectsData.projects[0];
const otherProjects = projectsData.projects.filter(p => p.id !== featuredProject.id).slice(0, 4);

// Helper to map tags to devicon classes
const getIconForTag = (tag: string) => {
  const t = tag.toLowerCase();
  if (t.includes('kubernetes')) return 'devicon-kubernetes-plain';
  if (t.includes('aws') || t.includes('amazon')) return 'devicon-amazonwebservices-plain-wordmark';
  if (t.includes('terraform')) return 'devicon-terraform-plain';
  if (t.includes('go')) return 'devicon-go-plain';
  if (t.includes('docker')) return 'devicon-docker-plain';
  if (t.includes('rust')) return 'devicon-rust-plain';
  if (t.includes('node')) return 'devicon-nodejs-plain';
  if (t.includes('react')) return 'devicon-react-original';
  if (t.includes('css')) return 'devicon-css3-plain';
  if (t.includes('typescript') || t.includes('ts')) return 'devicon-typescript-plain';
  if (t.includes('python')) return 'devicon-python-plain';
  return ''; // Default or empty if no icon
};
---

<section
  class="animate-on-scroll w-full px-margin-mobile md:px-margin-desktop py-section-gap max-w-container-max mx-auto border-t border-outline-variant scroll-mt-32"
  id="projects"
>
  <div class="mb-16 flex items-center justify-between">
    <h2 class="font-body-lg text-3xl font-light tracking-tight text-primary">
      Selected Projects
    </h2>
  </div>

  <!-- Featured Project -->
  <div class="mb-gutter bg-surface p-8 md:p-16 rounded-2xl flex flex-col lg:flex-row gap-12 items-center border border-outline-variant/20 shadow-sm hover:shadow-xl hover:-translate-y-2 hover:scale-[1.02] transition-all duration-500 ease-out group cursor-pointer">
    <div class="flex-1 w-full">
      <span class="font-label-sm text-label-sm text-secondary uppercase tracking-widest mb-6 block flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-primary inline-block"></span> Featured
      </span>
      <h3 class="font-display-lg-mobile md:text-5xl text-primary mb-6">
        {featuredProject.title}
      </h3>
      <p class="font-body-lg text-body-lg text-secondary mb-10 max-w-xl">
        {featuredProject.description}
      </p>
      <div class="flex flex-wrap gap-3 mb-10">
        {featuredProject.tags.map((tag) => {
          const icon = getIconForTag(tag);
          return (
            <span class="px-4 py-1.5 border border-outline-variant/50 text-secondary font-label-sm rounded-full flex items-center gap-2 hover:bg-surface-container-high transition-colors">
              {icon && <i class={`${icon} text-lg`} aria-hidden="true"></i>}
              {tag}
            </span>
          );
        })}
      </div>
      <a href={featuredProject.demoUrl || featuredProject.repoUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center space-x-3 text-primary font-label-sm uppercase tracking-widest opacity-80 group-hover:opacity-100 transition-opacity">
        <span>View Project</span>
        <span class="material-symbols-outlined text-sm transform group-hover:translate-x-2 transition-transform duration-300" aria-hidden="true">arrow_forward</span>
      </a>
    </div>
    <div class="flex-1 w-full aspect-video bg-surface-container-highest rounded-xl flex items-center justify-center border border-outline-variant/20 overflow-hidden relative">
      <!-- You could use an actual image tag here if featuredProject.image is a valid path -->
      <span class="material-symbols-outlined text-6xl text-outline-variant opacity-50 group-hover:scale-110 transition-transform duration-700" aria-hidden="true">cloud_queue</span>
    </div>
  </div>

  <!-- Grid of other projects -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-gutter">
    {otherProjects.map(project => (
      <a href={project.demoUrl || project.repoUrl} target="_blank" rel="noopener noreferrer" class="bg-surface p-8 md:p-10 rounded-2xl border border-outline-variant/20 shadow-sm hover:shadow-xl hover:-translate-y-2 hover:scale-[1.02] transition-all duration-500 ease-out group cursor-pointer block focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary">
        <div class="flex justify-between items-start mb-16">
          <h4 class="font-headline-md text-headline-md text-primary group-hover:text-surface-tint transition-colors">
            {project.title}
          </h4>
          <span class="material-symbols-outlined text-outline group-hover:text-primary transition-colors transform group-hover:translate-x-1 group-hover:-translate-y-1" aria-hidden="true">arrow_outward</span>
        </div>
        <p class="font-body-md text-body-md text-secondary mb-8">
          {project.summary}
        </p>
        <div class="flex flex-wrap gap-2">
          {project.tags.slice(0, 3).map((tag) => {
            const icon = getIconForTag(tag);
            return (
              <span class="px-3 py-1 bg-surface-container-low text-secondary font-label-sm rounded-md flex items-center gap-2">
                {icon && <i class={`${icon} text-base`} aria-hidden="true"></i>}
                {tag}
              </span>
            );
          })}
        </div>
      </a>
    ))}
  </div>

  <div class="mt-16 flex justify-center animate-on-scroll">
    <a
      class="inline-flex items-center justify-center px-10 py-4 border border-primary/30 text-primary bg-transparent font-label-sm uppercase tracking-[0.2em] rounded-sm hover:bg-primary hover:text-on-primary hover:scale-[1.02] transition-all duration-500 shadow-sm hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-on-primary"
      href="https://github.com/DevMo21x"
      target="_blank"
      rel="noopener noreferrer"
    >
      Explore All Repositories
    </a>
  </div>
</section>
