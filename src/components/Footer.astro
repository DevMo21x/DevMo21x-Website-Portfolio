---
import profileData from '../data/profile.json';

const currentYear = new Date().getFullYear();
---

<footer class="bg-surface/40 backdrop-blur-xl w-full mt-auto relative scroll-mt-32 text-primary border-t border-outline-variant/30" id="contact">
  <div class="w-full px-margin-mobile md:px-margin-desktop pt-20 pb-12 max-w-container-max mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-gutter pb-16">
      <!-- Brand & Mission Column -->
      <div class="md:col-span-5 flex flex-col justify-between pr-0 md:pr-12">
        <div>
          <a
            href="#"
            class="font-logo text-2xl font-bold tracking-[0.2em] uppercase text-primary inline-block mb-4 hover:opacity-80 transition-opacity focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded-sm"
          >
            {profileData.name}_21x
          </a>
          <p class="font-body-md text-body-md text-on-background/70 max-w-md leading-relaxed mb-8">
            {profileData.bio.short}
          </p>
        </div>
      </div>

      <!-- Links Grid -->
      <div class="md:col-span-7 grid grid-cols-2 sm:grid-cols-3 gap-8 pt-2 md:pt-0">
        <!-- Navigation -->
        <div class="flex flex-col space-y-3.5">
          <span class="font-label-sm text-label-sm uppercase tracking-widest text-secondary mb-1 block">Navigation</span>
          <a class="font-body-md text-body-md text-on-background/80 hover:text-primary hover:translate-x-1 transition-all inline-flex items-center gap-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded-sm" href="#experience">Experience</a>
          <a class="font-body-md text-body-md text-on-background/80 hover:text-primary hover:translate-x-1 transition-all inline-flex items-center gap-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded-sm" href="#projects">Projects</a>
          <a class="font-body-md text-body-md text-on-background/80 hover:text-primary hover:translate-x-1 transition-all inline-flex items-center gap-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded-sm" href="#certificates">Certifications</a>
        </div>

        <!-- Connect -->
        <div class="flex flex-col space-y-3.5">
          <span class="font-label-sm text-label-sm uppercase tracking-widest text-secondary mb-1 block">Connect</span>
          {profileData.socials.github && (
            <a class="font-body-md text-body-md text-on-background/80 hover:text-primary hover:translate-x-1 transition-all inline-flex items-center gap-2.5 group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded-sm" href={profileData.socials.github} target="_blank" rel="noopener noreferrer">
              <svg class="lucide lucide-github opacity-70 group-hover:opacity-100 transition-opacity" fill="none" height="16" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="16" aria-hidden="true"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.02c3.14-.35 6.5-1.4 6.5-7a4.6 4.6 0 0 0-1.3-3.2 4.1 4.1 0 0 0-.1-3.2s-1.1-.3-3.5 1.6a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.1 4.1 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 12.08c0 5.6 3.36 6.65 6.5 7a4.8 4.8 0 0 0-1 3.02v4"></path><path d="M9 18c-4.5 1.5-5-2.5-7-3"></path></svg>
              GitHub
            </a>
          )}
          {profileData.socials.linkedin && (
            <a class="font-body-md text-body-md text-on-background/80 hover:text-primary hover:translate-x-1 transition-all inline-flex items-center gap-2.5 group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded-sm" href={profileData.socials.linkedin} target="_blank" rel="noopener noreferrer">
              <svg class="lucide lucide-linkedin opacity-70 group-hover:opacity-100 transition-opacity" fill="none" height="16" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="16" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect height="12" width="4" x="2" y="9"></rect><circle cx="4" cy="4" r="2"></circle></svg>
              LinkedIn
            </a>
          )}
          <a class="font-body-md text-body-md text-on-background/80 hover:text-primary hover:translate-x-1 transition-all inline-flex items-center gap-2.5 group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded-sm" href={`mailto:${profileData.email}`}>
            <span class="material-symbols-outlined text-base opacity-70 group-hover:opacity-100 transition-opacity" aria-hidden="true">mail</span>
            Email
          </a>
        </div>

        <!-- Resources -->
        <div class="flex flex-col space-y-3.5 col-span-2 sm:col-span-1">
          <span class="font-label-sm text-label-sm uppercase tracking-widest text-secondary mb-1 block">Resources</span>
          {profileData.resumeUrl && (
            <a class="font-body-md text-body-md text-on-background/80 hover:text-primary hover:translate-x-1 transition-all inline-flex items-center gap-2.5 group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded-sm" href={profileData.resumeUrl} target="_blank" rel="noopener noreferrer">
              <span class="material-symbols-outlined text-base opacity-70 group-hover:opacity-100 transition-opacity" aria-hidden="true">description</span>
              Resume / CV
            </a>
          )}
          <a class="font-body-md text-body-md text-on-background/80 hover:text-primary hover:translate-x-1 transition-all inline-flex items-center gap-2.5 group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded-sm" href="https://github.com/DevMo21x/DevMo21x-Website-Portfolio" target="_blank" rel="noopener noreferrer">
            <span class="material-symbols-outlined text-base opacity-70 group-hover:opacity-100 transition-opacity" aria-hidden="true">code</span>
            Repository
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-outline-variant/30 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="font-body-md text-sm text-secondary text-center sm:text-left">
        © {currentYear} {profileData.name}. Engineered with precision & modern cloud principles.
      </p>
      <button
        class="inline-flex items-center gap-2 text-secondary hover:text-primary hover:-translate-y-1 transition-all duration-300 font-label-sm text-xs uppercase tracking-widest px-4 py-2 rounded-full bg-surface hover:bg-surface-container-highest border border-outline-variant/40 hover:border-outline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary group"
        onclick="window.scrollTo({top: 0, behavior: 'smooth'})"
        aria-label="Back to top"
      >
        <span>Back to Top</span>
        <span class="material-symbols-outlined text-base transform group-hover:-translate-y-0.5 transition-transform duration-300" aria-hidden="true">arrow_upward</span>
      </button>
    </div>
  </div>
</footer>
