---
import profileData from '../data/profile.json';
---

<footer class="fixed bottom-0 left-0 w-full h-[80vh] md:h-screen -z-10 bg-surface flex flex-col justify-end" id="contact">
  <div class="px-margin-mobile md:px-margin-desktop py-12 md:py-24 max-w-container-max mx-auto w-full flex flex-col h-full justify-between">
    
    <div class="flex-1 flex flex-col justify-center items-center text-center">
      <span class="font-label-sm text-secondary uppercase tracking-[0.3em] mb-8">Ready to collaborate?</span>
      <h2 class="font-display-lg-mobile md:text-[12vw] leading-[0.85] text-primary font-bold tracking-tighter mb-12 uppercase">
        Let's Talk
      </h2>
      <a 
        href={`mailto:${profileData.email}`} 
        class="group flex items-center gap-4 bg-primary text-on-primary px-8 py-5 rounded-full font-label-sm tracking-widest uppercase hover:scale-105 transition-transform duration-500 ease-out"
      >
        <span>Send a message</span>
        <div class="w-2 h-2 rounded-full bg-on-primary group-hover:scale-150 transition-transform duration-300"></div>
      </a>
    </div>

    <div class="border-t border-outline-variant/30 pt-8 flex flex-col md:flex-row justify-between items-center gap-6">
      <div class="flex items-center gap-8">
        <a href={profileData.socials.github} target="_blank" rel="noopener noreferrer" class="text-secondary hover:text-primary transition-colors font-label-sm tracking-widest uppercase text-xs">
          GitHub
        </a>
        <a href={profileData.socials.linkedin} target="_blank" rel="noopener noreferrer" class="text-secondary hover:text-primary transition-colors font-label-sm tracking-widest uppercase text-xs">
          LinkedIn
        </a>
      </div>
      <p class="font-label-sm text-xs text-secondary/60 tracking-widest uppercase">
        © {new Date().getFullYear()} {profileData.name}. All rights reserved.
      </p>
    </div>

  </div>
</footer>

<script>
  // Parallax footer logic requires the main content to have margin-bottom equal to footer height
  // This is handled by a resize observer to ensure responsiveness
  const setFooterMargin = () => {
    const footer = document.querySelector('footer');
    const main = document.querySelector('main');
    
    if (footer && main) {
      const footerHeight = footer.offsetHeight;
      main.style.marginBottom = `${footerHeight}px`;
      main.style.backgroundColor = 'var(--surface-container-low)'; // ensure main is opaque
      main.style.position = 'relative';
      main.style.zIndex = '10';
      main.style.boxShadow = '0 20px 40px rgba(0,0,0,0.5)';
    }
  };

  window.addEventListener('resize', setFooterMargin);
  
  // Set initial margin after a small delay to ensure styles are computed
  setTimeout(setFooterMargin, 100);
</script>
