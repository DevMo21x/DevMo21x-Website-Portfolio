---
import profileData from '../data/profile.json';
---

<section class="w-full px-margin-mobile md:px-margin-desktop pt-32 pb-section-gap max-w-container-max mx-auto">
  <div class="grid grid-cols-1 md:grid-cols-12 gap-gutter items-start">
    <div class="md:col-span-4 md:pt-4 mb-8 md:mb-0 hero-stagger-1">
      <span class="font-label-sm text-label-sm text-secondary uppercase tracking-widest block">
        {profileData.title}
      </span>
      <div class="w-12 h-[1px] bg-outline mt-6"></div>
    </div>
    <div class="md:col-span-8">
      <h1 class="font-body-lg text-[48px] leading-[1.1] tracking-tight md:text-[88px] text-primary mb-12 font-light hero-headline-animate">
        {profileData.tagline}
      </h1>
      <p class="font-headline-md text-headline-md text-secondary max-w-2xl italic mb-12 hero-stagger-2">
        {profileData.bio.short}
      </p>
      <div class="hero-stagger-3">
        <a
          class="inline-flex items-center justify-center px-10 py-4 border border-primary/30 text-primary bg-transparent font-label-sm uppercase tracking-[0.2em] rounded-sm hover:bg-primary hover:text-on-primary hover:scale-[1.02] transition-all duration-500 shadow-sm hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-on-primary"
          href="#projects"
        >
          VIEW CV
        </a>
      </div>
    </div>
  </div>
</section>
