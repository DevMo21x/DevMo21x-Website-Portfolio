---
import profileData from '../data/profile.json';
import StarBorder from './StarBorder.jsx';
---

<section
  class="w-full px-margin-mobile md:px-margin-desktop pt-32 pb-section-gap max-w-container-max mx-auto"
>
  <div class="grid grid-cols-1 md:grid-cols-12 gap-gutter items-start">
    <div class="md:col-span-4 md:pt-4 mb-8 md:mb-0 hero-stagger-1">
      <span class="font-label-sm text-label-sm text-secondary uppercase tracking-widest block">
        {profileData.title}
      </span>
      <div class="w-12 h-[1px] bg-outline-variant mt-6"></div>
    </div>
    <div class="md:col-span-8">
      <h1
        class="font-display-lg-mobile md:text-display-lg text-primary mb-10 hero-headline-animate"
      >
        {profileData.tagline}
      </h1>
      <p class="font-body-lg text-on-background/80 max-w-2xl font-light mb-12 hero-stagger-2">
        {profileData.bio.short}
      </p>
      <div class="hero-stagger-3 flex flex-wrap items-center gap-4">
        <a class="btn-luxury-primary group" href="#projects">
          <span>Explore Projects</span>
          <span
            class="material-symbols-outlined text-base transform group-hover:translate-x-1 transition-transform duration-300"
            aria-hidden="true">arrow_forward</span
          >
        </a>
        <StarBorder
          as="a"
          href={profileData.resumeUrl || '#contact'}
          target={profileData.resumeUrl ? '_blank' : '_self'}
          rel="noopener noreferrer"
          color="magenta"
          speed="2s"
          client:load
        >
          <span
            class="material-symbols-outlined text-base text-secondary group-hover:text-primary transition-colors"
            aria-hidden="true">description</span
          >
          <span>View Resume</span>
        </StarBorder>
      </div>
    </div>
  </div>
</section>
