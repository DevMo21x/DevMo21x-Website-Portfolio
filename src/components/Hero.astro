---
import profileData from '../data/profile.json';
import HeroVisual from './HeroVisual.tsx';
import { Button } from './ui/button.tsx';
---

<section class="relative w-full min-h-[90vh] flex items-center overflow-hidden bg-surface-container-low" id="hero">
  <!-- GSAP Animated Visual Background -->
  <HeroVisual client:load />

  <div class="relative z-10 w-full px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto">
    <div class="flex flex-col items-start w-full md:w-3/4 lg:w-2/3">
      
      <div class="hero-element opacity-0 translate-y-10 mb-8">
        <span class="font-label-sm text-label-sm text-secondary uppercase tracking-[0.2em] flex items-center gap-4">
          <span class="w-12 h-[1px] bg-primary block"></span>
          {profileData.title}
        </span>
      </div>

      <h1 class="hero-element opacity-0 translate-y-10 font-display-lg-mobile md:text-[10vw] lg:text-[110px] leading-[0.9] text-primary font-bold tracking-tight mb-8">
        {profileData.tagline}
      </h1>

      <p class="hero-element opacity-0 translate-y-10 font-body-lg text-on-background/80 max-w-xl font-light leading-relaxed mb-12">
        {profileData.bio.short}
      </p>

      <div class="hero-element opacity-0 translate-y-10 flex flex-wrap items-center gap-6">
        <a href="#projects" class="hero-cta block">
          <Button size="lg" className="h-14 px-8 text-base tracking-wide bg-primary text-on-primary font-medium hover:bg-primary transition-none rounded-full">
            Explore Projects
            <span class="material-symbols-outlined ml-2 text-xl" aria-hidden="true">arrow_forward</span>
          </Button>
        </a>
        
        {profileData.resumeUrl && (
          <a 
            href={profileData.resumeUrl} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="hero-resume flex items-center gap-2 text-secondary hover:text-primary transition-colors font-label-sm tracking-widest uppercase"
          >
            <span class="material-symbols-outlined text-lg" aria-hidden="true">description</span>
            View Resume
          </a>
        )}
      </div>

    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';

  // GSAP Entrance Timeline
  const tl = gsap.timeline({ defaults: { ease: 'power4.out' } });

  // Initial delay to wait for layout, then stagger the elements in
  tl.to('.hero-element', {
    y: 0,
    opacity: 1,
    duration: 1.2,
    stagger: 0.15,
    delay: 0.2
  });

  // CTA Hover Animation using GSAP (Scale/Transform, not flat color)
  const cta = document.querySelector('.hero-cta');
  const ctaBtn = cta?.querySelector('button');
  const ctaIcon = cta?.querySelector('.material-symbols-outlined');

  if (cta && ctaBtn && ctaIcon) {
    cta.addEventListener('mouseenter', () => {
      gsap.to(ctaBtn, {
        scale: 1.05,
        duration: 0.4,
        ease: 'back.out(1.5)',
      });
      gsap.to(ctaIcon, {
        x: 4,
        duration: 0.3,
        ease: 'power2.out',
      });
    });

    cta.addEventListener('mouseleave', () => {
      gsap.to(ctaBtn, {
        scale: 1,
        duration: 0.4,
        ease: 'power2.out',
      });
      gsap.to(ctaIcon, {
        x: 0,
        duration: 0.3,
        ease: 'power2.out',
      });
    });
  }
</script>
