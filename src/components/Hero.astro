---
import profileData from '../data/profile.json';
---

<section class="w-full px-margin-mobile md:px-margin-desktop pt-32 pb-section-gap max-w-container-max mx-auto">
  <div class="grid grid-cols-1 md:grid-cols-12 gap-gutter items-start">
    <div class="md:col-span-4 md:pt-4 mb-8 md:mb-0 hero-stagger-1">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-surface/80 border border-outline-variant/50 text-xs font-label-sm text-on-background/80 mb-6 backdrop-blur-md">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        <span class="tracking-wider uppercase text-[11px] font-medium text-white/90">Available for Opportunities</span>
      </div>
      <span class="font-label-sm text-label-sm text-secondary uppercase tracking-widest block">
        {profileData.title}
      </span>
      <div class="w-12 h-[1px] bg-outline-variant mt-6"></div>
    </div>
    <div class="md:col-span-8">
      <h1 class="font-display-lg-mobile md:text-display-lg text-primary mb-10 hero-headline-animate">
        {profileData.tagline}
      </h1>
      <p class="font-body-lg text-on-background/80 max-w-2xl font-light mb-12 hero-stagger-2">
        {profileData.bio.short}
      </p>
      <div class="hero-stagger-3 flex flex-wrap items-center gap-4">
        <a
          class="btn-luxury-primary group"
          href="#projects"
        >
          <span>Explore Projects</span>
          <span class="material-symbols-outlined text-base transform group-hover:translate-x-1 transition-transform duration-300" aria-hidden="true">arrow_forward</span>
        </a>
        <a
          class="btn-luxury-secondary group"
          href={profileData.resumeUrl || '#contact'}
          target={profileData.resumeUrl ? "_blank" : "_self"}
          rel="noopener noreferrer"
        >
          <span class="material-symbols-outlined text-base text-secondary group-hover:text-primary transition-colors" aria-hidden="true">description</span>
          <span>View Resume</span>
        </a>
      </div>
    </div>
  </div>
</section>
