---
import experienceData from '../data/experience.json';
---

<section
  class="animate-on-scroll w-full px-margin-mobile md:px-margin-desktop py-section-gap max-w-container-max mx-auto border-t border-outline-variant scroll-mt-32"
  id="certificates"
>
  <div class="grid grid-cols-1 md:grid-cols-12 gap-gutter">
    <div class="md:col-span-4">
      <h2 class="font-headline-md text-primary mb-8 md:mb-0">
        Certifications & Accolades
      </h2>
    </div>
    <div class="md:col-span-8 flex flex-col divide-y divide-outline-variant/30">
      {experienceData.certifications.map((cert) => (
        <div
          class="flex justify-between items-center py-6 hover:px-6 hover:bg-surface/40 backdrop-blur-sm transition-all duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] -mx-4 px-4 cursor-pointer group rounded-2xl hover:shadow-[0_4px_20px_rgba(0,0,0,0.3)] hover:border-transparent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
          tabindex="0"
          role="link"
        >
          <span class="font-body-lg text-body-lg text-primary group-hover:text-surface-tint flex flex-col md:flex-row md:items-center gap-2 md:gap-4 transition-colors font-light">
            {cert.title}
            <span class="material-symbols-outlined text-base opacity-0 group-hover:opacity-100 transition-all duration-300 -translate-x-3 group-hover:translate-x-0 text-primary hidden md:inline-block" aria-hidden="true">arrow_forward</span>
          </span>
          <span class="font-label-sm text-xs text-secondary uppercase tracking-widest shrink-0 mt-2 md:mt-0 text-right px-3 py-1 rounded-full bg-surface-container-highest/60 border border-outline-variant/30 group-hover:border-outline-variant/60 group-hover:text-primary transition-colors">
            {cert.issuer} • {cert.year}
          </span>
        </div>
      ))}
    </div>
  </div>
</section>
