---
import experienceData from '../data/experience.json';
---

<section
  class="animate-on-scroll w-full px-margin-mobile md:px-margin-desktop py-section-gap max-w-container-max mx-auto border-t border-outline-variant scroll-mt-32"
  id="certificates"
>
  <div class="grid grid-cols-1 md:grid-cols-12 gap-gutter">
    <div class="md:col-span-4">
      <h2 class="font-body-lg text-3xl font-light tracking-tight text-primary mb-8 md:mb-0">
        Certifications & Accolades
      </h2>
    </div>
    <div class="md:col-span-8 flex flex-col">
      {experienceData.certifications.map((cert) => (
        <div
          class="flex justify-between items-center py-6 border-b hover:pl-4 hover:bg-surface transition-all duration-300 ease-out -mx-4 px-4 cursor-pointer group rounded-lg hover:shadow-md hover:-translate-y-0.5 hover:scale-[1.01] border-outline-variant focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
          tabindex="0"
          role="link"
        >
          <span class="font-body-lg text-body-lg text-primary group-hover:text-surface-tint flex flex-col md:flex-row md:items-center gap-2 md:gap-4 transition-colors">
            {cert.title}
            <span class="material-symbols-outlined text-xl opacity-0 group-hover:opacity-100 transition-all duration-300 -translate-x-4 group-hover:translate-x-1 text-primary hidden md:inline-block" aria-hidden="true">arrow_forward</span>
          </span>
          <span class="font-label-sm text-label-sm text-secondary uppercase tracking-widest shrink-0 mt-2 md:mt-0 text-right">
            {cert.issuer} • {cert.year}
          </span>
        </div>
      ))}
    </div>
  </div>
</section>
