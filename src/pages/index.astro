<span class="px-3 py-1 bg-surface-container-low text-secondary font-label-sm rounded-md flex items-center gap-2"><i class="devicon-go-plain text-base"></i> Go</span>
<span class="px-3 py-1 bg-surface-container-low text-secondary font-label-sm rounded-md flex items-center gap-2"><i class="devicon-docker-plain text-base"></i> Docker</span>
</div>
</div>
<!-- Project Card 2 -->
<div class="bg-surface p-8 md:p-10 rounded-2xl border border-outline-variant/20 shadow-sm hover:shadow-xl hover:-translate-y-2 hover:scale-[1.02] transition-all duration-500 ease-out group cursor-pointer">
