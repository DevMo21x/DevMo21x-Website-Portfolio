---
import Layout from "../layouts/Layout.astro";
---

<Layout title="DevMo_21x - Developer Portfolio">
<!-- TopNavBar -->
<header class="bg-surface-container-low/90 backdrop-blur-md w-full sticky top-0 z-50 border-b border-outline-variant/30">
<div class="flex justify-between items-center w-full px-margin-mobile md:px-margin-desktop py-4 max-w-container-max mx-auto">
<a class="logo-animate font-logo text-xl font-bold tracking-[0.2em] text-primary uppercase" href="#">DevMo_21x</a>
<nav class="hidden md:flex space-x-12 items-center">
<a class="font-label-sm text-label-sm uppercase tracking-widest text-secondary hover:text-primary transition-colors relative after:absolute after:left-0 after:-bottom-1 after:h-[1px] after:w-full after:bg-primary after:scale-x-0 after:origin-right hover:after:scale-x-100 hover:after:origin-left after:transition-transform after:duration-300 after:ease-out" href="#experience">Experience</a>
<a class="font-label-sm text-label-sm uppercase tracking-widest text-secondary hover:text-primary transition-colors relative after:absolute after:left-0 after:-bottom-1 after:h-[1px] after:w-full after:bg-primary after:scale-x-0 after:origin-right hover:after:scale-x-100 hover:after:origin-left after:transition-transform after:duration-300 after:ease-out" href="#projects">Projects</a>
<a class="font-label-sm text-label-sm uppercase tracking-widest text-secondary hover:text-primary transition-colors relative after:absolute after:left-0 after:-bottom-1 after:h-[1px] after:w-full after:bg-primary after:scale-x-0 after:origin-right hover:after:scale-x-100 hover:after:origin-left after:transition-transform after:duration-300 after:ease-out" href="#certificates">Certificates</a>
</nav>
<a class="hidden md:inline-flex items-center justify-center px-6 py-2.5 border border-primary/20 text-primary bg-transparent font-label-sm uppercase tracking-[0.15em] rounded-sm hover:bg-primary hover:text-on-primary hover:scale-[1.02] transition-all duration-500 ease-out shadow-sm hover:shadow-md" href="#contact">
<span class="relative z-10">Connect</span>
</a>
<button class="md:hidden text-primary">
<span class="material-symbols-outlined text-2xl">menu</span>
</button>
</div>
</header>
<main class="flex-grow">
<!-- Hero Section -->
<section class="w-full px-margin-mobile md:px-margin-desktop pt-32 pb-section-gap max-w-container-max mx-auto">
<div class="grid grid-cols-1 md:grid-cols-12 gap-gutter items-start">
<div class="md:col-span-4 md:pt-4 mb-8 md:mb-0 hero-stagger-1">
<span class="font-label-sm text-label-sm text-secondary uppercase tracking-widest block">Systems / Cloud / Infrastructure</span>
<div class="w-12 h-[1px] bg-outline mt-6"></div>
</div>
<div class="md:col-span-8">
<h1 class="font-body-lg text-[48px] leading-[1.1] tracking-tight md:text-[88px] text-primary mb-12 font-light hero-headline-animate">
                        Architecting high-scale cloud infrastructure.
                    </h1>
<p class="font-headline-md text-headline-md text-secondary max-w-2xl italic mb-12 hero-stagger-2">
                        I engineer robust, distributed systems and cloud-native applications. Specializing in designing scalable architectures, automating deployments, and ensuring high availability across complex Kubernetes environments and AWS ecosystems.
                    </p>
<div class="hero-stagger-3">
<a class="inline-flex items-center justify-center px-10 py-4 border border-primary/30 text-primary bg-transparent font-label-sm uppercase tracking-[0.2em] rounded-sm hover:bg-primary hover:text-on-primary hover:scale-[1.02] transition-all duration-500 shadow-sm hover:shadow-md" href="#projects">
                            VIEW CV
                        </a>
</div>
</div>
</div>
</section>
<!-- Projects Section -->
<section class="animate-on-scroll w-full px-margin-mobile md:px-margin-desktop py-section-gap max-w-container-max mx-auto border-t is-visible border-outline-variant" id="projects">
<div class="mb-16 flex items-center justify-between">
<h2 class="font-body-lg text-3xl font-light tracking-tight text-primary">Selected Projects</h2>
</div>
<!-- Featured Project -->
<div class="mb-gutter bg-surface p-8 md:p-16 rounded-2xl flex flex-col lg:flex-row gap-12 items-center border border-outline-variant/20 shadow-sm hover:shadow-xl hover:-translate-y-2 hover:scale-[1.02] transition-all duration-500 ease-out group cursor-pointer">
<div class="flex-1 w-full">
<span class="font-label-sm text-label-sm text-secondary uppercase tracking-widest mb-6 block flex items-center gap-2">
<span class="w-2 h-2 rounded-full bg-primary inline-block"></span> Featured
        </span>
<h3 class="font-display-lg-mobile md:text-5xl text-primary mb-6">Global Scale Microservices Platform</h3>
<p class="font-body-lg text-body-lg text-secondary mb-10 max-w-xl">
            A resilient, multi-region deployment platform utilizing Kubernetes and AWS EKS. Designed to handle peak loads of 500k+ RPS with self-healing capabilities, automated scaling policies, and comprehensive observability pipelines.
        </p>
<div class="flex flex-wrap gap-3 mb-10">
<span class="px-4 py-1.5 border border-outline-variant/50 text-secondary font-label-sm rounded-full flex items-center gap-2 hover:bg-surface-container-high transition-colors"><i class="devicon-kubernetes-plain text-lg"></i> Kubernetes</span>
<span class="px-4 py-1.5 border border-outline-variant/50 text-secondary font-label-sm rounded-full flex items-center gap-2 hover:bg-surface-container-high transition-colors"><i class="devicon-amazonwebservices-plain-wordmark text-lg"></i> AWS</span>
<span class="px-4 py-1.5 border border-outline-variant/50 text-secondary font-label-sm rounded-full flex items-center gap-2 hover:bg-surface-container-high transition-colors"><i class="devicon-terraform-plain text-lg"></i> Terraform</span>
</div>
<span class="inline-flex items-center space-x-3 text-primary font-label-sm uppercase tracking-widest opacity-80 group-hover:opacity-100 transition-opacity">
<span class="">View Architecture</span>
<span class="material-symbols-outlined text-sm transform group-hover:translate-x-2 transition-transform duration-300">arrow_forward</span>
</span>
</div>
<div class="flex-1 w-full aspect-video bg-surface-container-highest rounded-xl flex items-center justify-center border border-outline-variant/20 overflow-hidden relative">
<span class="material-symbols-outlined text-6xl text-outline-variant opacity-50 group-hover:scale-110 transition-transform duration-700">cloud_queue</span>
</div>
</div>
<!-- Grid of other projects -->
<div class="grid grid-cols-1 md:grid-cols-2 gap-gutter">
<!-- Project Card 1 -->
