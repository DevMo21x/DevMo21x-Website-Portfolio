---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ProjectsSection from '../components/ProjectsSection.astro';
import ExperienceSection from '../components/ExperienceSection.astro';
import TechStackSection from '../components/TechStackSection.astro';
import CertificationsSection from '../components/CertificationsSection.astro';
import Footer from '../components/Footer.astro';
import GlassDock from '../components/GlassDock.astro';
---

<Layout title="DevMo_21x">
  <Header />
  <main id="main" class="flex-grow relative z-10 bg-surface-container-low shadow-[0_20px_40px_rgba(0,0,0,0.5)] transition duration-300">
    <Hero />
    <ProjectsSection />
    <ExperienceSection />
    <TechStackSection />
    <CertificationsSection />
  </main>
  <GlassDock />
  <Footer />
</Layout>
