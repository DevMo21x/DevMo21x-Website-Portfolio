---
import '../styles/input.css';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html class="light scroll-smooth" lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Source+Serif+4:ital,wght@0,300;0,400;0,500;0,600;1,400&family=Space+Grotesk:wght@700&display=swap" rel="stylesheet">
		<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
		<link href="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/devicon.min.css" rel="stylesheet" type="text/css">
        <style is:global>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;
        }
        
        @media (prefers-reduced-motion: no-preference) {
            .animate-on-scroll {
                opacity: 0;
                transform: translateY(30px);
                transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
            }
            .animate-on-scroll.is-visible {
                opacity: 1;
                transform: translateY(0);
            }

            .hero-stagger-1 {
                opacity: 0;
                transform: translateY(20px);
                animation: heroFadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.1s forwards;
            }
            .hero-stagger-2 {
                opacity: 0;
                transform: translateY(20px);
                animation: heroFadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.3s forwards;
            }
            .hero-stagger-3 {
                opacity: 0;
                transform: translateY(20px);
                animation: heroFadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.5s forwards;
            }

            .hero-headline-animate {
                background: linear-gradient(to right, #000 20%, #666 40%, #666 60%, #000 80%);
                background-size: 200% auto;
                color: transparent;
                -webkit-background-clip: text;
                background-clip: text;
                animation: shimmer-reveal 2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
            }
            
            .animate-infinite-scroll {
                animation: infinite-scroll 40s linear infinite;
            }
            
            .logo-animate {
                display: inline-block;
                animation: logo-glitch 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94) both, logo-float 4s ease-in-out infinite 0.8s;
            }
        }
        
        @media (prefers-reduced-motion: reduce) {
            .hero-headline-animate {
                background: none;
                color: inherit;
                -webkit-background-clip: border-box;
                background-clip: border-box;
            }
        }
        </style>
	</head>
	<body class="bg-surface-container-low text-on-background font-body-md antialiased min-h-screen flex flex-col selection:bg-primary selection:text-on-primary overflow-x-hidden">
		<a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:z-[100] p-4 bg-primary text-on-primary">Skip to main content</a>
		<slot />
		<script src="../scripts/app.ts"></script>
	</body>
</html>
